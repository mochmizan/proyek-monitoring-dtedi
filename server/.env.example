# HubGate V5 Central Server Environment Variables Example
# Copy to .env in server/ for local development

# Database connection URL (PostgreSQL Docker container)
# Format: postgresql://[user]:[pass]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smsb_prod

# Seed credentials for initial Hub registration
HUB_NAME=hs109rs-hub-01
HUB_KEY=strong_local_hub_key_1234567890abcdef

# CORS configuration for Vite Frontend Dev Server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in every environment. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=

# ---------------------------------------------------------------------------
# Security hardening (pentest findings F-04/05/06/13/14/16)
# ---------------------------------------------------------------------------
# IMPORTANT: set ENV=prod in production. It is what activates the secure
# defaults below (docs off, Secure cookie on, HSTS on) and the fail-fast
# guards (refuse to start with the insecure default HUB_KEY / SQLite fallback).
ENV=prod

# The following have safe defaults derived from ENV; override only if needed.
# ENABLE_DOCS=false                # expose /docs,/redoc,/openapi.json (default: off in prod)   F-14
# COOKIE_SECURE=true               # Secure flag on session cookie (default: on in prod)        F-16
# ENABLE_HSTS=true                 # Strict-Transport-Security header (default: on in prod)     F-13
# MAX_BODY_SIZE=1048576            # max JSON request body in bytes (default: 1 MB)             F-05
# MAX_FUTURE_TIMESTAMP_SECONDS=86400 # telemetry clock-skew tolerance in seconds (default: 24h)     F-06
# IOT_RATE_LIMIT_PER_HUB=1200/minute                                                            # F-04
# IOT_BATCH_RATE_LIMIT_PER_HUB=60/minute                                                        # F-04
