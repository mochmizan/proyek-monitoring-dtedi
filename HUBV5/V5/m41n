# brain of hub v.5

import os
import json
import time
import requests
import logging
import threading
import paho.mqtt.client as mqtt
from dotenv import load_dotenv

load_dotenv()

# KONFIGURASI ENVIRONMENT
MQTT_HOST = os.getenv("MQTT_HOST", "localhost")
MQTT_PORT = int(os.getenv("MQTT_PORT", 1883))
MQTT_USER = os.getenv("MQTT_USER", "hub_user")          # [V5 SECURITY] MQTT Username
MQTT_PASS = os.getenv("MQTT_PASS", "password_rahasia")   # [V5 SECURITY] MQTT Password
MQTT_TOPIC = os.getenv("MQTT_TOPIC", "hs109rs/#")

SERVER_URL = os.getenv("SERVER_URL")                 # Endpoint kirim telemetri resmi
SERVER_DEVICES_URL = os.getenv("SERVER_DEVICES_URL") # Endpoint ambil daftar whitelist
SERVER_ALERT_URL = os.getenv("SERVER_ALERT_URL")     # Endpoint lapor IoT baru (pending)

HUB_NAME = os.getenv("HUB_NAME")
HUB_KEY = os.getenv("HUB_KEY")                      # [V5 SECURITY] Key Rahasia Hub ke Server

# [V5 SECURITY] Path Sertifikat SSL Lokal (Strict SSL Verification)
CERT_PATH = os.path.join(os.path.dirname(__file__), "cert.crt")

SYNC_INTERVAL = 30  # Interval (detik) untuk memperbarui whitelist dari Server

# GLOBAL CACHE
ALLOWED_DEVICES = {}        # Format: {"MAC_ADDRESS": {"DEV_NAME": ..., "DEV_TYPE": ...}}
REPORTED_UNAPPROVED = set() # Mencegah spam notifikasi perangkat yang sama ke Server

# KONFIGURASI LOGGING
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s"
)
logging.info("Hub Edge Filtering Service V5 Started")


def get_headers():
    """[V5 SECURITY] Menghasilkan Header HTTP lengkap dengan X-Hub-ID dan X-Hub-Key."""
    return {
        "X-Hub-ID": HUB_NAME,
        "X-Hub-Key": HUB_KEY,
        "Content-Type": "application/json"
    }


def sync_whitelist():
    """Meminta daftar perangkat resmi dari Dashboard Server secara berkala di background thread."""
    global ALLOWED_DEVICES
    while True:
        try:
            # [V5 SECURITY] Verifikasi HTTPS dengan cert.crt & pengiriman X-Hub-Key
            response = requests.get(
                SERVER_DEVICES_URL,
                timeout=5,
                headers=get_headers(),
                verify=CERT_PATH if os.path.exists(CERT_PATH) else False
            )
            if response.ok:
                devices_list = response.json()
                # Simpan DEV_ID (MAC Address) ke memori lokal RAM
                ALLOWED_DEVICES = {d["DEV_ID"]: d for d in devices_list if "DEV_ID" in d}
                logging.info(f"[SYNC] Whitelist lokal diperbarui. {len(ALLOWED_DEVICES)} perangkat resmi terdaftar.")
            else:
                logging.warning(f"[SYNC] Gagal mengambil whitelist dari server (HTTP {response.status_code}).")
        except Exception as e:
            logging.error(f"[SYNC] Error SSL/Koneksi ke Server: {e}")

        time.sleep(SYNC_INTERVAL)


def notify_unapproved_device(data):
    """Melaporkan ke Dashboard Server bahwa ada perangkat asing (MAC baru) yang mencoba terhubung."""
    DEV_ID = data.get("DEV_ID")
    if not DEV_ID or DEV_ID in REPORTED_UNAPPROVED:
        return  # Abaikan jika tidak ada MAC atau sudah pernah dilaporkan

    try:
        payload = {
            "HUB_NAME": HUB_NAME,
            "DEV_ID": DEV_ID,
            "DEV_TYPE": data.get("DEV_TYPE", "UNKNOWN"),
            "DEV_NAME": data.get("DEV_NAME", "UNAPPROVED_DEVICE"),
            "status": "PENDING_APPROVAL"
        }
        # [V5 SECURITY] Verifikasi HTTPS dengan cert.crt & pengiriman X-Hub-Key
        response = requests.post(
            SERVER_ALERT_URL,
            json=payload,
            timeout=5,
            headers=get_headers(),
            verify=CERT_PATH if os.path.exists(CERT_PATH) else False
        )
        if response.ok:
            logging.warning(f"[ALERT] Perangkat tak dikenal ({DEV_ID}) dilaporkan ke Dashboard Server.")
            REPORTED_UNAPPROVED.add(DEV_ID)
    except Exception as e:
        logging.error(f"[ALERT] Gagal mengirim notifikasi perangkat baru ke server: {e}")


def send_program_to_iot(client, DEV_ID, config_data):
    """Mengirimkan program/konfigurasi balik ke IoT via MQTT Topic khusus perangkat."""
    response_topic = f"iot/config/{DEV_ID}"
    payload = json.dumps(config_data)
    client.publish(response_topic, payload, qos=1)
    logging.info(f"[RESPONSE] Program/Konfigurasi dikirim ke {DEV_ID} di topic '{response_topic}'")


def send_server(data):
    """Meneruskan data telemetri terverifikasi ke Server."""
    try:
        # [V5 SECURITY] Verifikasi HTTPS dengan cert.crt & pengiriman X-Hub-Key
        response = requests.post(
            SERVER_URL,
            json=data,
            timeout=5,
            headers=get_headers(),
            verify=CERT_PATH if os.path.exists(CERT_PATH) else False
        )
        if response.ok:
            logging.info(f"[FORWARD] Data dari {data.get('DEV_ID')} berhasil diteruskan ke Server.")
        else:
            logging.error(f"[FORWARD] Server menolak data: HTTP {response.status_code}")
    except requests.exceptions.Timeout:
        logging.error("[FORWARD] Server timeout")
    except requests.exceptions.ConnectionError:
        logging.error("[FORWARD] Tidak dapat terhubung ke server")
    except Exception as e:
        logging.exception(e)


def on_connect(client, userdata, flags, reason_code, properties):
    if reason_code == 0:
        logging.info(f"Connected to Local Broker ({MQTT_HOST})")
        result, _ = client.subscribe(MQTT_TOPIC)
        if result == mqtt.MQTT_ERR_SUCCESS:
            logging.info(f"Subscribed to topic: {MQTT_TOPIC}")
        else:
            logging.error("Subscribe failed")
    else:
        logging.error(f"Connection to Broker failed with code {reason_code}")


def on_message(client, userdata, msg):
    try:
        data = json.loads(msg.payload.decode())
        DEV_ID = data.get("DEV_ID")

        if not DEV_ID:
            logging.warning("[REJECT] Payload diterima tanpa DEV_ID (MAC Address). Diabaikan.")
            return

        # ==========================================================
        # VERIFIKASI LOKAL DI EDGE HUB (RASPBERRY PI)
        # ==========================================================
        if DEV_ID in ALLOWED_DEVICES:
            logging.info(f"[VERIFIED] Perangkat Resmi Terdeteksi: {DEV_ID}")

            # 1. Kirim Konfigurasi/Program balik ke IoT
            device_info = ALLOWED_DEVICES[DEV_ID]
            config = {
                "status": "AUTHORIZED",
                "HUB_NAME": HUB_NAME,
                "DEV_TYPE": device_info.get("DEV_TYPE"),
                "interval_ms": 5000,
                "command": "RUN"
            }
            send_program_to_iot(client, DEV_ID, config)

            # 2. Teruskan JSON ke Cloud Server via HTTPS
            send_server(data)

        else:
            # PERANGKAT TIDAK TERDAFTAR (BLOCKED DI EDGE)
            logging.warning(f"[BLOCKED] Akses Ditolak untuk MAC: {DEV_ID}. Data TIDAK diteruskan ke Server.")

            # Laporkan ke Server agar muncul di Dashboard Admin
            notify_unapproved_device(data)

    except json.JSONDecodeError:
        logging.error("Invalid JSON received from MQTT")


def main():
    # 1. Jalankan Background Thread untuk Sync Whitelist
    sync_thread = threading.Thread(target=sync_whitelist, daemon=True)
    sync_thread.start()

    # 2. Inisialisasi MQTT Client
    client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
    
    # [V5 SECURITY] Login ke Broker Mosquitto
    if MQTT_USER and MQTT_PASS:
        client.username_pw_set(MQTT_USER, MQTT_PASS)

    client.on_connect = on_connect
    client.on_message = on_message

    try:
        client.connect(MQTT_HOST, MQTT_PORT)
    except Exception as e:
        logging.exception("MQTT Connection Failed")
        return

    try:
        client.loop_forever()
    except KeyboardInterrupt:
        logging.info("Hub Service Stopped")


if __name__ == "__main__":
    main()